# All Ayurvedics environment variables.
# Copy to .env.local for development. Never commit real secrets.
# On Vercel, set Production values in Project → Settings → Environment Variables.

# =============================================================================
# PUBLIC — inlined into the browser. Never put a secret in NEXT_PUBLIC_*.
# =============================================================================

# Canonical origin. Production should be https://allayurvedics.in.
# Leave unset for `next dev` (defaults to http://localhost:3000).
# Leave unset for a production build to default to https://allayurvedics.in.
NEXT_PUBLIC_SITE_URL=https://allayurvedics.in

# Optional. Defaults to NEXT_PUBLIC_SITE_URL. Only set if share images must come from another host.
# NEXT_PUBLIC_OG_BASE_URL=https://allayurvedics.in

# Google Search Console HTML-tag value (the content="…" string only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Shown on About / Privacy / Terms / footer when set.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@allayurvedics.in

# UPI payee VPA is public (customers see it). Not a secret. Env overrides src/config/site.ts.
# NEXT_PUBLIC_UPI_ID=yourname@okhdfcbank
# NEXT_PUBLIC_UPI_PAYEE_NAME=All Ayurvedics

# Digits with country code, no plus. Env overrides src/config/site.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Hosted payment link for a product. Name is PAYMENT_LINK_<SLUG_IN_UPPER_SNAKE>.
# Read on the server at build/request time. Do not prefix with NEXT_PUBLIC_.
# PAYMENT_LINK_HIMALAYAN_SHILAJIT_RESIN_10G=https://rzp.io/rzp/example

# =============================================================================
# SERVER-ONLY SECRETS — never prefix these with NEXT_PUBLIC_.
# =============================================================================

# Postgres connection string (Neon or any Postgres). Required in production unless
# Upstash is set below. Stores enquiries, accounts, and the shared API rate limiter.
# Production does not fall back to in-memory rate limits. `next dev` does.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Customer accounts stay off until all three are set. AUTH_SECRET must be 32+ characters.
# ACCOUNTS_ENABLED=true
# AUTH_SECRET=

# Transactional email. Use Resend or Brevo, plus a verified from-address.
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=All Ayurvedics <hello@allayurvedics.in>
# ENQUIRY_TO_EMAIL=hello@allayurvedics.in

# Newsletter list. Brevo list id, or Resend (optional segment).
# BREVO_LIST_ID=
# RESEND_SEGMENT_ID=

# Optional shared rate-limit store. If both are set, they are used instead of Postgres.
# Set both, or neither. Production requires this pair or DATABASE_URL.
# Do not commit real tokens.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Authorizes GET /api/cron/rate-limit-cleanup (Vercel Cron sends Authorization: Bearer).
# Use a random string of at least 16 characters, preferably 32+. Required for scheduled cleanup.
# Generate with: openssl rand -base64 32
# CRON_SECRET=
